{
  "name": "etsy-listing-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local desktop-style assistant: generate listing content with Claude, then create Etsy draft listings from this computer.",
  "scripts": {
    "dev": "concurrently -n server,ui,open \"npm run dev:server\" \"npm run dev:client\" \"npm run open:ui\"",
    "dev:server": "cross-env ETSY_ASSISTANT_NO_OPEN=1 ETSY_ASSISTANT_UI_URL=http://127.0.0.1:5173 tsx watch src/server/server.ts",
    "dev:client": "vite --port 5173",
    "open:ui": "tsx src/server/open-browser.ts http://127.0.0.1:5173",
    "start": "tsx src/server/server.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.28",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
